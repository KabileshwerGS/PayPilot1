# ==============================================================================
# PayPilot Backend Environment Variables
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your actual .env file to version control.

# Application Configuration
PROJECT_NAME="PayPilot Autonomous Back Office"
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="sqlite:///./paypilot.db"
#
# Production (Supabase PostgreSQL via Transaction Pooler port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# CORS & Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app"
FRONTEND_URL="https://your-frontend-app.vercel.app"
FRONTEND_PUBLIC_URL="https://your-frontend-app.vercel.app"

# PayPal API Configuration
# ------------------------------------------------------------------------------
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# Currency Exchange Rate Service
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"

# SMTP Email Configuration (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="billing@paypilot.app"
