# PayPilot Frontend Environment Configuration
# Copy this file to .env for local development

# Backend API Base URL
# - In local development: Leave blank to use Vite's built-in /api proxy, or set to http://localhost:8000
# - In production (Vercel): Set to your Render backend URL (e.g., https://paypilot-backend.onrender.com)
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_URL="http://localhost:8000"

# Public URL of the frontend application
# Used for generating shareable invoice checkout links, creator tip jars, and POS QR payment targets
# - In local development: http://localhost:5173
# - In production (Vercel): https://your-paypilot-app.vercel.app
VITE_PUBLIC_URL="http://localhost:5173"
